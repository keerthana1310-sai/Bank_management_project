<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.bank.controller.LoginController"
           stylesheets="@styles.css"
           styleClass="login-bg"
           prefWidth="960.0" prefHeight="650.0">

    <VBox alignment="CENTER" maxWidth="480.0" spacing="20.0">
        <padding>
            <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
        </padding>

        <!-- Main Card Container -->
        <VBox styleClass="login-card" spacing="18.0">
            <!-- Header Brand -->
            <VBox alignment="CENTER" spacing="8.0">
                <HBox alignment="CENTER" spacing="10.0">
                    <Label text="🏦" style="-fx-font-size: 32px;"/>
                    <VBox alignment="CENTER_LEFT">
                        <Text text="Apex Trust Bank" styleClass="heading-lg" style="-fx-fill: #0f2942;"/>
                        <Text text="Enterprise Banking Management Portal" styleClass="text-secondary" style="-fx-font-size: 12px;"/>
                    </VBox>
                </HBox>
                
                <!-- Demo Mode Notification Badge -->
                <HBox alignment="CENTER" styleClass="demo-banner">
                    <Label fx:id="modeBadgeLabel" text="⚡ DEMO / COLLEGE EVALUATION MODE ACTIVE" styleClass="demo-badge-text"/>
                </HBox>
            </VBox>

            <Separator/>

            <!-- Form Content -->
            <VBox spacing="14.0">
                <!-- Username -->
                <VBox spacing="6.0">
                    <Label text="Username / Staff ID" styleClass="form-label"/>
                    <TextField fx:id="usernameField" promptText="Enter username (e.g. admin or keerthana)"
                               onAction="#handleLogin"/>
                </VBox>

                <!-- Password -->
                <VBox spacing="6.0">
                    <Label text="Password" styleClass="form-label"/>
                    <PasswordField fx:id="passwordField" promptText="Enter password"
                                   onAction="#handleLogin"/>
                </VBox>

                <!-- Feedback Message Label -->
                <Label fx:id="messageLabel" text="" wrapText="true" visible="false" managed="false"/>

                <!-- Action Buttons -->
                <Button fx:id="loginButton" text="Sign In to Portal →" 
                        onAction="#handleLogin" 
                        maxWidth="Infinity" 
                        styleClass="btn-primary" 
                        style="-fx-font-size: 14px; -fx-padding: 11px 20px;"/>

                <Button text="⚡ Bypass Login &amp; Open Dashboard Directly →" 
                        onAction="#handleBypass" 
                        maxWidth="Infinity" 
                        styleClass="btn-success" 
                        style="-fx-font-size: 13px; -fx-padding: 10px 18px;"/>
            </VBox>

            <Separator/>

            <!-- Demo Helper Section -->
            <VBox styleClass="demo-credentials-box" spacing="6.0">
                <HBox alignment="CENTER_LEFT" spacing="6.0">
                    <Label text="💡" style="-fx-font-size: 14px;"/>
                    <Label text="Quick Demo Credentials (Click to fill):" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
                </HBox>
                <HBox spacing="10.0" alignment="CENTER">
                    <Button text="Admin (admin / admin123)" onAction="#fillAdminCredentials" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 5px 10px;"/>
                    <Button text="Lead (keerthana / bank2026)" onAction="#fillKeerthanaCredentials" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 5px 10px;"/>
                </HBox>
            </VBox>

            <!-- Footer Note -->
            <VBox alignment="CENTER">
                <Text text="Bank Management System • College Project 2026" 
                      styleClass="text-muted" style="-fx-font-size: 11px;"/>
                <Text text="Frontend: Keerthana | Accounts: Pranita | Tx: Jayasree | DB: Yashaswi" 
                      styleClass="text-muted" style="-fx-font-size: 10px;"/>
            </VBox>
        </VBox>
    </VBox>
</StackPane>
