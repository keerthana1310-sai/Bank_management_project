<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bank.controller.TransactionController"
            stylesheets="@styles.css"
            prefWidth="1260.0" prefHeight="840.0">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox styleClass="sidebar">
            <VBox styleClass="sidebar-brand-box" spacing="6.0">
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <StackPane styleClass="brand-emblem-box">
                        <Label text="🏦" style="-fx-font-size: 20px;"/>
                    </StackPane>
                    <VBox spacing="2.0">
                        <Text text="APEX TRUST BANK" styleClass="brand-title"/>
                        <Text text="Banking Beyond Expectations." styleClass="brand-tagline"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Categorized Navigation Container -->
            <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                <VBox styleClass="sidebar-nav-container" spacing="4.0">
                    <!-- Section: OVERVIEW -->
                    <Label text="OVERVIEW" styleClass="sidebar-category-label"/>
                    <Button text="📊  Executive Dashboard" onAction="#navToDashboard" maxWidth="Infinity" styleClass="nav-button"/>

                    <!-- Section: BANKING OPERATIONS -->
                    <Label text="BANKING OPERATIONS" styleClass="sidebar-category-label"/>
                    <Button text="👤  Account Management" onAction="#navToAccounts" maxWidth="Infinity" styleClass="nav-button"/>
                    <Button text="💳  Transaction Centre" onAction="#navToTransactions" maxWidth="Infinity" styleClass="nav-button, nav-button-active"/>
                    <Button text="🔁  Fund Transfers" onAction="#navToTransfers" maxWidth="Infinity" styleClass="nav-button"/>
                    <Button text="📜  Transaction History" onAction="#navToHistory" maxWidth="Infinity" styleClass="nav-button"/>

                    <!-- Section: MANAGEMENT -->
                    <Label text="MANAGEMENT" styleClass="sidebar-category-label"/>
                    <Button text="📑  Reports &amp; Statements" onAction="#navToReports" maxWidth="Infinity" styleClass="nav-button"/>
                    <Button text="🔔  Notification Centre" onAction="#navToNotifications" maxWidth="Infinity" styleClass="nav-button"/>
                    <Button text="🛡️  Security Overview" onAction="#navToSecurity" maxWidth="Infinity" styleClass="nav-button"/>

                    <Region prefHeight="16.0"/>

                    <!-- Authenticated Operator Card -->
                    <VBox styleClass="user-profile-card" spacing="4.0">
                        <Text text="AUTHENTICATED OPERATOR" style="-fx-fill: #94A3B8; -fx-font-size: 9.5px; -fx-font-weight: 800; -fx-letter-spacing: 0.6px;"/>
                        <Label fx:id="operatorNameLabel" text="Priya Nair (Branch Officer)" style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-font-size: 12.5px;"/>
                        <Label text="Module: Teller Services Terminal" style="-fx-text-fill: #93C5FD; -fx-font-size: 11px;"/>
                    </VBox>

                    <!-- Logout Button -->
                    <Button text="🚪  Log Out" onAction="#handleLogout" maxWidth="Infinity" styleClass="nav-button-logout"/>
                </VBox>
            </ScrollPane>
        </VBox>
    </left>

    <!-- MAIN BODY -->
    <center>
        <VBox>
            <!-- Top Header -->
            <HBox styleClass="top-header" alignment="CENTER_LEFT" spacing="20.0">
                <VBox spacing="2.0">
                    <Text text="Transaction Processing Terminal" styleClass="heading-lg"/>
                    <Label text="Execute cash deposits, over-the-counter withdrawals, and authorized intra-bank funds transfers." styleClass="text-secondary" style="-fx-font-size: 11.5px;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER" spacing="12.0">
                    <HBox alignment="CENTER" spacing="6.0" styleClass="system-status-chip">
                        <Label text="●" style="-fx-text-fill: #16A34A; -fx-font-size: 11px;"/>
                        <Label text="System Operational" style="-fx-text-fill: #15803D; -fx-font-weight: bold; -fx-font-size: 11.5px;"/>
                    </HBox>
                    <HBox alignment="CENTER" spacing="6.0" styleClass="date-chip">
                        <Label text="📅" style="-fx-font-size: 12px;"/>
                        <Label fx:id="currentDateLabel" text="12 Nov 2026" style="-fx-font-weight: bold; -fx-text-fill: #1E293B; -fx-font-size: 12px;"/>
                    </HBox>
                    <Button onAction="#navToNotifications" styleClass="header-icon-btn">
                        <graphic>
                            <Label text="🔔" style="-fx-font-size: 13px;"/>
                        </graphic>
                    </Button>
                    <HBox alignment="CENTER" styleClass="demo-banner">
                        <Label fx:id="demoBadgeLabel" text="⚡ In-Memory Demo" styleClass="demo-badge-text"/>
                    </HBox>
                </HBox>
            </HBox>

            <!-- Scrollable Content Area -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                <VBox styleClass="content-area" spacing="22.0">

                    <!-- Global Alert Notification -->
                    <Label fx:id="statusAlertLabel" text="" wrapText="true" visible="false" managed="false"/>

                    <GridPane hgap="22.0" vgap="20.0">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="55.0"/>
                            <ColumnConstraints percentWidth="45.0"/>
                        </columnConstraints>

                        <!-- Card 1: Transaction Terminal Form -->
                        <VBox GridPane.columnIndex="0" styleClass="card" spacing="16.0">
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label text="💳" style="-fx-font-size: 20px;"/>
                                <VBox spacing="2.0">
                                    <Text text="Teller Operations Terminal" styleClass="heading-md"/>
                                    <Label text="Verify customer authorization, balance availability, and post entry" styleClass="text-secondary" style="-fx-font-size: 11.5px;"/>
                                </VBox>
                            </HBox>
                            <Separator/>

                            <!-- Transaction Reference & Date Row -->
                            <GridPane hgap="12.0" vgap="10.0">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50.0"/>
                                    <ColumnConstraints percentWidth="50.0"/>
                                </columnConstraints>
                                <VBox GridPane.columnIndex="0" spacing="4.0">
                                    <Label text="Transaction Reference #" styleClass="form-label"/>
                                    <TextField fx:id="referenceField" editable="false" style="-fx-background-color: #F8FAFC; -fx-text-fill: #64748B;"/>
                                </VBox>
                                <VBox GridPane.columnIndex="1" spacing="4.0">
                                    <Label text="Posting Date" styleClass="form-label"/>
                                    <TextField fx:id="txDateField" editable="false" style="-fx-background-color: #F8FAFC; -fx-text-fill: #64748B;"/>
                                </VBox>
                            </GridPane>

                            <!-- Transaction Type Selector -->
                            <VBox spacing="5.0">
                                <Label text="Select Transaction Type *" styleClass="form-label"/>
                                <ComboBox fx:id="transactionTypeCombo" maxWidth="Infinity" onAction="#handleTypeChanged"/>
                            </VBox>

                            <!-- Source Account Number & Customer Name Preview -->
                            <VBox spacing="5.0">
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Source Account Number *" styleClass="form-label"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Hyperlink text="Check Balance Preview" onAction="#handleCheckSourceAccount" style="-fx-font-size: 11.5px; -fx-text-fill: #2563EB; -fx-font-weight: bold;"/>
                                </HBox>
                                <TextField fx:id="sourceAccountField" promptText="e.g. ACC-1001"
                                           onAction="#handleCheckSourceAccount"/>
                                <HBox alignment="CENTER_LEFT" spacing="6.0">
                                    <Label text="Account Holder:" style="-fx-font-size: 11px; -fx-text-fill: #64748B;"/>
                                    <Label fx:id="customerNameDisplayLabel" text="Aarav Sharma" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                                </HBox>
                            </VBox>

                            <!-- Destination Account (For Transfers only) -->
                            <VBox fx:id="destAccountBox" spacing="5.0">
                                <Label text="Destination Account Number (For Transfers) *" styleClass="form-label"/>
                                <TextField fx:id="destAccountField" promptText="e.g. ACC-1002"/>
                                <Label text="Required for inter-account wire transfers only." styleClass="text-muted" style="-fx-font-size: 11px;"/>
                            </VBox>

                            <!-- Monetary Amount -->
                            <VBox spacing="5.0">
                                <Label text="Transaction Amount (₹) *" styleClass="form-label"/>
                                <TextField fx:id="amountField" promptText="e.g. 5000.00 (Must be strictly positive)"/>
                            </VBox>

                            <!-- Description / Memo -->
                            <VBox spacing="5.0">
                                <Label text="Transaction Memo / Remarks (Optional)" styleClass="form-label"/>
                                <TextField fx:id="descriptionField" promptText="e.g. Counter deposit, vendor settlement, tuition fee"/>
                            </VBox>

                            <!-- Action Buttons -->
                            <HBox spacing="14.0" alignment="CENTER_LEFT">
                                <Button fx:id="submitButton" text="⚡ Execute Transaction" onAction="#handleSubmitTransaction" styleClass="btn-primary" style="-fx-font-size: 13.5px; -fx-padding: 10px 22px;"/>
                                <Button text="Reset Form" onAction="#handleClearForm" styleClass="btn-secondary"/>
                            </HBox>
                        </VBox>

                        <!-- Card 2: Live Account Telemetry, Confirmation & Digital Receipt -->
                        <VBox GridPane.columnIndex="1" spacing="20.0">

                            <!-- Account Balance Preview Card -->
                            <VBox styleClass="card" spacing="12.0">
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <Label text="🔍" style="-fx-font-size: 16px;"/>
                                    <VBox spacing="1.0">
                                        <Text text="Source Account Telemetry" styleClass="heading-md"/>
                                        <Label text="Live balance verification from core ledger" styleClass="text-secondary" style="-fx-font-size: 11px;"/>
                                    </VBox>
                                </HBox>
                                <Separator/>
                                <VBox spacing="8.0">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="Account Status:" style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="previewStatusLabel" text="ACTIVE" styleClass="badge-active"/>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="Account Holder:" style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="previewHolderLabel" text="Aarav Sharma" style="-fx-font-weight: bold; -fx-text-fill: #1E293B; -fx-font-size: 13px;"/>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="Available Ledger Balance:" style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="previewBalanceLabel" text="₹85,500.00" style="-fx-font-weight: bold; -fx-text-fill: #16A34A; -fx-font-size: 16px;"/>
                                    </HBox>
                                </VBox>
                            </VBox>

                            <!-- Pre-Submission Confirmation Summary Card -->
                            <VBox fx:id="confirmationCard" styleClass="confirmation-summary-card" spacing="10.0">
                                <HBox alignment="CENTER_LEFT" spacing="6.0">
                                    <Label text="📋" style="-fx-font-size: 15px;"/>
                                    <Text text="Operation Confirmation Summary" styleClass="heading-md" style="-fx-fill: #1E3A8A; -fx-font-size: 13.5px;"/>
                                </HBox>
                                <Separator/>
                                <GridPane vgap="6.0" hgap="10.0">
                                    <Label text="Selected Operation:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-text-fill: #64748B; -fx-font-size: 11.5px;"/>
                                    <Label fx:id="confirmTypeLabel" text="DEPOSIT" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #10243A;"/>

                                    <Label text="Source Account:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-text-fill: #64748B; -fx-font-size: 11.5px;"/>
                                    <Label fx:id="confirmSourceLabel" text="ACC-1001" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-font-weight: bold;"/>

                                    <Label text="Target Account:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-text-fill: #64748B; -fx-font-size: 11.5px;"/>
                                    <Label fx:id="confirmDestLabel" text="N/A (Cash Operation)" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                    <Label text="Operation Amount:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-text-fill: #64748B; -fx-font-size: 11.5px;"/>
                                    <Label fx:id="confirmAmountLabel" text="₹0.00" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #2563EB; -fx-font-size: 13.5px;"/>
                                </GridPane>
                            </VBox>

                            <!-- Digital Receipt Card (Displayed on success) -->
                            <VBox fx:id="receiptBox" styleClass="card" spacing="14.0" style="-fx-border-color: #16A34A; -fx-border-width: 1.5;" visible="false" managed="false">
                                <HBox alignment="CENTER_LEFT">
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                        <Label text="✅" style="-fx-font-size: 18px;"/>
                                        <Text text="Digital Transaction Receipt" styleClass="heading-md" style="-fx-fill: #065F46;"/>
                                    </HBox>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="receiptTypeBadge" text="DEPOSIT" styleClass="badge-deposit"/>
                                </HBox>

                                <Separator/>

                                <GridPane vgap="8.0" hgap="12.0">
                                    <Label text="Receipt / TX ID:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-text-fill: #64748B; -fx-font-size: 11.5px;"/>
                                    <Label fx:id="receiptTxIdLabel" text="#5012" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #0F172A;"/>

                                    <Label text="Source Account:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-text-fill: #64748B; -fx-font-size: 11.5px;"/>
                                    <Label fx:id="receiptSourceLabel" text="ACC-1001" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-font-weight: bold;"/>

                                    <Label text="Destination Account:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-text-fill: #64748B; -fx-font-size: 11.5px;"/>
                                    <Label fx:id="receiptDestLabel" text="--" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                    <Label text="Processed Amount:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-text-fill: #64748B; -fx-font-size: 11.5px;"/>
                                    <Label fx:id="receiptAmountLabel" text="₹5,000.00" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-font-weight: bold; -fx-font-size: 14.5px; -fx-text-fill: #2563EB;"/>

                                    <Label text="Updated Ledger Balance:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-text-fill: #64748B; -fx-font-size: 11.5px;"/>
                                    <Label fx:id="receiptNewBalanceLabel" text="₹90,500.00" GridPane.rowIndex="4" GridPane.columnIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #16A34A;"/>

                                    <Label text="Execution Timestamp:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-text-fill: #64748B; -fx-font-size: 11.5px;"/>
                                    <Label fx:id="receiptTimestampLabel" text="12 Nov 2026, 14:00" GridPane.rowIndex="5" GridPane.columnIndex="1" style="-fx-text-fill: #64748B; -fx-font-size: 11.5px;"/>
                                </GridPane>
                            </VBox>

                        </VBox>
                    </GridPane>

                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
