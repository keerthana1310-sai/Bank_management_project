<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bank.controller.ReportsController"
            stylesheets="@styles.css"
            prefWidth="1260.0" prefHeight="840.0">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox styleClass="sidebar">
            <VBox styleClass="sidebar-brand-box" spacing="6.0">
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <StackPane styleClass="brand-emblem-box">
                        <Label text="🏦" style="-fx-font-size: 20px;"/>
                    </StackPane>
                    <VBox spacing="2.0">
                        <Text text="APEX TRUST BANK" styleClass="brand-title"/>
                        <Text text="Banking Beyond Expectations." styleClass="brand-tagline"/>
                    </VBox>
                </HBox>
            </VBox>

            <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                <VBox styleClass="sidebar-nav-container" spacing="4.0">
                    <!-- Section: OVERVIEW -->
                    <Label text="OVERVIEW" styleClass="sidebar-category-label"/>
                    <Button text="📊  Executive Dashboard" onAction="#navToDashboard" maxWidth="Infinity" styleClass="nav-button"/>

                    <!-- Section: BANKING OPERATIONS -->
                    <Label text="BANKING OPERATIONS" styleClass="sidebar-category-label"/>
                    <Button text="👤  Account Management" onAction="#navToAccounts" maxWidth="Infinity" styleClass="nav-button"/>
                    <Button text="💳  Transaction Centre" onAction="#navToTransactions" maxWidth="Infinity" styleClass="nav-button"/>
                    <Button text="🔁  Fund Transfers" onAction="#navToTransfers" maxWidth="Infinity" styleClass="nav-button"/>
                    <Button text="📜  Transaction History" onAction="#navToHistory" maxWidth="Infinity" styleClass="nav-button"/>

                    <!-- Section: MANAGEMENT -->
                    <Label text="MANAGEMENT" styleClass="sidebar-category-label"/>
                    <Button text="📑  Reports &amp; Statements" onAction="#navToReports" maxWidth="Infinity" styleClass="nav-button, nav-button-active"/>
                    <Button text="🔔  Notification Centre" onAction="#navToNotifications" maxWidth="Infinity" styleClass="nav-button"/>
                    <Button text="🛡️  Security Overview" onAction="#navToSecurity" maxWidth="Infinity" styleClass="nav-button"/>

                    <Region prefHeight="16.0"/>

                    <VBox styleClass="user-profile-card" spacing="4.0">
                        <Text text="AUTHENTICATED OPERATOR" style="-fx-fill: #94A3B8; -fx-font-size: 9.5px; -fx-font-weight: 800; -fx-letter-spacing: 0.6px;"/>
                        <Label fx:id="operatorNameLabel" text="Priya Nair (Branch Officer)" style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-font-size: 12.5px;"/>
                        <Label text="Module: Financial Reporting" style="-fx-text-fill: #93C5FD; -fx-font-size: 11px;"/>
                    </VBox>

                    <Button text="🚪  Log Out" onAction="#handleLogout" maxWidth="Infinity" styleClass="nav-button-logout"/>
                </VBox>
            </ScrollPane>
        </VBox>
    </left>

    <!-- MAIN BODY -->
    <center>
        <VBox>
            <!-- Top Header -->
            <HBox styleClass="top-header" alignment="CENTER_LEFT" spacing="20.0">
                <VBox spacing="2.0">
                    <Text text="Reports &amp; Financial Statements" styleClass="heading-lg"/>
                    <Label text="Generate audited customer statements, operational cashflow summaries, and export CSV ledger reports." styleClass="text-secondary" style="-fx-font-size: 11.5px;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER" spacing="12.0">
                    <HBox alignment="CENTER" spacing="6.0" styleClass="system-status-chip">
                        <Label text="●" style="-fx-text-fill: #16A34A; -fx-font-size: 11px;"/>
                        <Label text="Reporting Engine Active" style="-fx-text-fill: #15803D; -fx-font-weight: bold; -fx-font-size: 11.5px;"/>
                    </HBox>
                    <HBox alignment="CENTER" spacing="6.0" styleClass="date-chip">
                        <Label text="📅" style="-fx-font-size: 12px;"/>
                        <Label fx:id="currentDateLabel" text="12 Nov 2026" style="-fx-font-weight: bold; -fx-text-fill: #1E293B; -fx-font-size: 12px;"/>
                    </HBox>
                    <Button onAction="#navToNotifications" styleClass="header-icon-btn">
                        <graphic>
                            <Label text="🔔" style="-fx-font-size: 13px;"/>
                        </graphic>
                    </Button>
                    <HBox alignment="CENTER" styleClass="demo-banner">
                        <Label fx:id="demoBadgeLabel" text="⚡ In-Memory Demo" styleClass="demo-badge-text"/>
                    </HBox>
                </HBox>
            </HBox>

            <!-- Scrollable Content Area -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                <VBox styleClass="content-area" spacing="22.0">

                    <!-- Status Alert Feedback -->
                    <Label fx:id="statusFeedbackLabel" text="" wrapText="true" visible="false" managed="false"/>

                    <!-- Control & Generator Card -->
                    <VBox styleClass="card" spacing="16.0">
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label text="📑" style="-fx-font-size: 18px;"/>
                            <VBox spacing="2.0">
                                <Text text="Report Generator &amp; Criteria Selection" styleClass="heading-md"/>
                                <Label text="Select statement parameter, target account, and reporting period" styleClass="text-secondary" style="-fx-font-size: 11.5px;"/>
                            </VBox>
                        </HBox>
                        <Separator/>

                        <GridPane hgap="14.0" vgap="12.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="30.0"/>
                                <ColumnConstraints percentWidth="30.0"/>
                                <ColumnConstraints percentWidth="20.0"/>
                                <ColumnConstraints percentWidth="20.0"/>
                            </columnConstraints>

                            <!-- Report Type -->
                            <VBox GridPane.columnIndex="0" spacing="4.0">
                                <Label text="Report Template *" styleClass="form-label"/>
                                <ComboBox fx:id="reportTypeCombo" maxWidth="Infinity" onAction="#handleGenerateReport"/>
                            </VBox>

                            <!-- Target Account Selection -->
                            <VBox GridPane.columnIndex="1" spacing="4.0">
                                <Label text="Target Account (For Statements)" styleClass="form-label"/>
                                <ComboBox fx:id="accountSelectCombo" maxWidth="Infinity" onAction="#handleGenerateReport"/>
                            </VBox>

                            <!-- Period Filter -->
                            <VBox GridPane.columnIndex="2" spacing="4.0">
                                <Label text="Reporting Period" styleClass="form-label"/>
                                <ComboBox fx:id="periodSelectCombo" maxWidth="Infinity" onAction="#handleGenerateReport"/>
                            </VBox>

                            <!-- Actions -->
                            <VBox GridPane.columnIndex="3" spacing="4.0" alignment="BOTTOM_LEFT">
                                <Label text="" styleClass="form-label"/>
                                <HBox spacing="8.0">
                                    <Button text="Generate" onAction="#handleGenerateReport" styleClass="btn-primary"/>
                                    <Button text="📥 Export CSV" onAction="#handleExportCSV" styleClass="btn-success"/>
                                </HBox>
                            </VBox>
                        </GridPane>
                    </VBox>

                    <!-- Report Summary KPI Tiles -->
                    <GridPane hgap="16.0" vgap="16.0">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="30.0"/>
                            <ColumnConstraints percentWidth="25.0"/>
                            <ColumnConstraints percentWidth="25.0"/>
                            <ColumnConstraints percentWidth="20.0"/>
                        </columnConstraints>

                        <VBox GridPane.columnIndex="0" styleClass="kpi-card" spacing="4.0">
                            <Label text="REPORT TITLE" styleClass="kpi-title"/>
                            <Label fx:id="metricReportTitle" text="Customer Account Statement" styleClass="kpi-value" style="-fx-font-size: 15px;"/>
                        </VBox>

                        <VBox GridPane.columnIndex="1" styleClass="kpi-card" spacing="4.0">
                            <Label text="TOTAL RECORDS" styleClass="kpi-title"/>
                            <Label fx:id="metricRecordCount" text="0 Entries" styleClass="kpi-value" style="-fx-font-size: 20px;"/>
                        </VBox>

                        <VBox GridPane.columnIndex="2" styleClass="kpi-card" spacing="4.0">
                            <Label text="TOTAL LIQUIDITY" styleClass="kpi-title"/>
                            <Label fx:id="metricTotalVolume" text="₹0.00" styleClass="kpi-value" style="-fx-font-size: 20px; -fx-text-fill: #16A34A;"/>
                        </VBox>

                        <VBox GridPane.columnIndex="3" styleClass="kpi-card" spacing="4.0">
                            <Label text="VERIFICATION STATUS" styleClass="kpi-title"/>
                            <Label fx:id="metricNetSummary" text="Audited &amp; Reconciled" style="-fx-text-fill: #2563EB; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                        </VBox>
                    </GridPane>

                    <!-- Preview Table Card -->
                    <VBox styleClass="card" spacing="14.0">
                        <HBox alignment="CENTER_LEFT">
                            <Text text="Generated Statement / Report Preview" styleClass="heading-md"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="🔄 Refresh Report" onAction="#handleGenerateReport" styleClass="btn-secondary"/>
                        </HBox>

                        <TableView fx:id="reportTable" prefHeight="380.0">
                            <columns>
                                <TableColumn fx:id="tCol1" text="Col 1" prefWidth="120.0"/>
                                <TableColumn fx:id="tCol2" text="Col 2" prefWidth="180.0"/>
                                <TableColumn fx:id="tCol3" text="Col 3" prefWidth="160.0"/>
                                <TableColumn fx:id="tCol4" text="Col 4" prefWidth="160.0"/>
                                <TableColumn fx:id="tCol5" text="Col 5" prefWidth="160.0"/>
                                <TableColumn fx:id="tCol6" text="Col 6" prefWidth="300.0"/>
                            </columns>
                            <placeholder>
                                <Label text="No records available for the selected report criteria."/>
                            </placeholder>
                        </TableView>
                    </VBox>

                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>

