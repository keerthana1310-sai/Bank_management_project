# ===================================================================
# Bank Management System - Environment Variables Configuration
# Copy this file to .env and replace the values with your local settings.
# NEVER commit the actual .env file or real database passwords to Git!
# ===================================================================

# Database Connection Settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bank_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Application Configuration
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true

# Demo Mode Configuration
# Set to 'true' to use in-memory demo services (no MySQL needed)
# Set to 'false' to connect to live MySQL database
DEMO_MODE=true
